# Flask
SECRET_KEY=replace-with-a-long-random-string

# Neon Postgres. Application traffic uses the POOLER host. init-db uses the direct host.
# Leave DATABASE_URL empty to use a local SQLite file (local.db) for development.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Admin login (no user table; compared with hmac.compare_digest)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Shop identity (optional; defaults are built in)
SHOP_NAME=Psaa
SHOP_TAGLINE=Everyday clothes, cut simply.

# Image storage. With Neon, `neon deploy` fills the AWS_* names and the app uses them.
# S3_BUCKET must match the bucket in neon.ts. Leave AWS_* empty to stay on local disk.
STORAGE_BACKEND=s3
S3_BUCKET=assets
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://BRANCH.storage.REGION.aws.neon.tech
AWS_REGION=ap-southeast-1

# Bakong KHQR merchant (shown on checkout; orders are not marked paid)
BAKONG_ACCOUNT_ID=yourname@bank
MERCHANT_NAME=Psaa
MERCHANT_CITY=Phnom Penh

# Optional manual "Check payment status" button. The proxy (../bakong-proxy) must run from a
# Cambodia IP. Leave the URL empty and the button says the check is not configured.
BAKONG_PROXY_URL=
BAKONG_PROXY_SECRET=
